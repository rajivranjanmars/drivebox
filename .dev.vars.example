APP_ENV=development
BETTER_AUTH_SECRET=ExampleSecretKeyForBetterAuthExampleSecretKeyForBetterAuth
BETTER_AUTH_URL=http://localhost:3000

# Use a dedicated development bucket. R2 and other S3-compatible providers work here.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=replace-with-your-private-bucket
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_SESSION_TOKEN=
