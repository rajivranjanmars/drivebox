{
  "name": "drivebox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "bun run typecheck && bun run lint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test vite.config.ts vitest.config.mts drizzle.config.ts eslint.config.mjs tailwind.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply drivebox --local",
    "db:migrate:remote": "wrangler d1 migrations apply drivebox --remote",
    "cf:typegen": "wrangler types --env-file .dev.vars.example --env-interface CloudflareEnv cloudflare-env.d.ts && bun -e 'const path = \"cloudflare-env.d.ts\"; const source = await Bun.file(path).text(); await Bun.write(path, source.replace(/[ \\t]+$/gm, \"\"));'",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-start": "^1.168.44",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "lucide-react": "^1.31.0",
    "pretty-bytes": "^7.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0",
    "yaml": "^2.9.0"
  }
}
