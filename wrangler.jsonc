{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drivebox",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drivebox",
      "database_id": "3a67fbc0-7add-4c56-9d04-3af45d6dd3e8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://drivebox.rajivranjanmars.workers.dev",
    "S3_ENDPOINT": "https://replace-with-account-id.r2.cloudflarestorage.com",
    "S3_REGION": "auto",
    "S3_BUCKET": "drivebox-files",
    "S3_ADDRESSING_STYLE": "path"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
