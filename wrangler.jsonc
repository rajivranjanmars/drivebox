{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drivebox",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drivebox",
      "database_id": "3a67fbc0-7add-4c56-9d04-3af45d6dd3e8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "drivebox-files"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://drivebox.rajivranjanmars.workers.dev",
    "STORAGE_BACKEND": "r2"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
